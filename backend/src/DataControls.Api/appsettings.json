{
  "Database": {
    "ConnectionString": "Server=.\\SQLEXPRESS;Database=DataControls;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False",
    "RuleReaderUser": "dc_rule_reader",
    "CommandTimeoutSeconds": 30,
    "MaxStoredViolations": 10000
  },
  "Advisor": {
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 60,
    "ServiceToken": "dev-internal-token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080"
}
